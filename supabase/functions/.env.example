# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically
# by hosted Supabase Edge Functions.

HEARTBEAT_SECRET=replace-with-a-long-random-value

TARGET_API_URL=https://your-model-provider.example/v1/chat/completions
TARGET_API_KEY=replace-with-your-api-key
MODEL_NAME=replace-with-your-model-name
MAX_TOKENS=256
MODEL_TIMEOUT_MS=90000

BARK_KEY=replace-with-your-bark-device-key
CUSTOM_ICON_URL=

TIME_ZONE=Asia/Shanghai
CRON_INTERVAL_MINUTES=10

DIARY_ENABLED=true

# The wake thresholds, cooldown, model output limit and optional weather
# settings are stored in the dylan_heartbeat_settings table.
